# Copiar este archivo a .env.local para desarrollo local.
# En Vercel: Project Settings > Environment Variables (no commitear el valor real).

REDASH_BASE_URL=https://redash.humand.co
REDASH_QUERY_ID=49867
REDASH_API_KEY=pegar_aqui_el_api_key_de_la_query

# Registro de descargas de PDF (Google Sheets). Ver README, sección
# "Registro de descargas" para el paso a paso de cómo obtener estos valores.
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\naaaa...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=pegar_aqui_el_id_del_google_sheet
